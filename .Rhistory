# =================================================================
# Análisis descriptivo de la base de datos "datos"
#
# Artículo: Lakdawala, Patel, Bakhru y Modi (2025). Performance
# optimization of low-head vertical axis impulse turbine runners...
# Journal of Thermal Engineering, 11(5), 1392-1419.
#
# Respuesta:   eficiencia hidráulica de la turbina (proporción)
# Explicativas: angulo, diametro y distancia de la boquilla (numéricas),
#               rodete (Pelton/Turgo) y boquillas (1 o 2) (categóricas)
# =================================================================
# -----------------------------------------------------------------
# 0. Paquetes
# -----------------------------------------------------------------
# Se instalan solo los que falten, para que el script corra en
# cualquier computador
paquetes <- c("readxl", "ggplot2", "GGally")
faltantes <- paquetes[!paquetes %in% rownames(installed.packages())]
if (length(faltantes) > 0) install.packages(faltantes)
library(readxl)
library(ggplot2)
library(GGally)
theme_set(theme_bw())   # mismo estilo para todos los gráficos
set.seed(2026)          # geom_jitter() mueve los puntos al azar; con la
# semilla los gráficos salen iguales cada vez
# -----------------------------------------------------------------
# 1. Lectura de los datos desde el repositorio de GitHub
# -----------------------------------------------------------------
url <- "https://raw.githubusercontent.com/mariasaurius/Articulo_regresion/main/datos.xlsx"
# read_excel() no lee directamente desde internet: primero se descarga
# el archivo a una ruta temporal (mode = "wb" evita daños en Windows)
archivo <- tempfile(fileext = ".xlsx")
download.file(url, destfile = archivo, mode = "wb")
datos <- as.data.frame(read_excel(archivo))
# Variables categóricas como factores
datos$rodete    <- factor(datos$rodete, levels = c("PTR", "TTR"),
labels = c("Pelton", "Turgo"))
datos$boquillas <- factor(datos$boquillas, levels = c(1, 2),
labels = c("1 boquilla", "2 boquillas"))
# -----------------------------------------------------------------
# 2. Estructura general de la base
# -----------------------------------------------------------------
dim(datos)              # 80 corridas y 7 variables
str(datos)
head(datos)
colSums(is.na(datos))   # no debe haber datos faltantes
# -----------------------------------------------------------------
# 3. Revisión del diseño experimental
# -----------------------------------------------------------------
# Los datos vienen de un diseño central compuesto (CCD): cada variable
# numérica toma solo 3 niveles. Se revisa cuántas corridas hay por nivel
table(datos$angulo)
table(datos$diametro)
table(datos$distancia)
table(datos$rodete, datos$boquillas)
# En los puntos factoriales (niveles extremos) cada combinación debería
# aparecer una sola vez. Se buscan combinaciones repetidas:
factoriales <- subset(datos, angulo != 92.5 & diametro != 12 & distancia != 50)
clave <- with(factoriales, paste(angulo, diametro, distancia, rodete, boquillas))
factoriales[clave %in% clave[duplicated(clave)], ]
# Las corridas 12 y 13 tienen los mismos valores pero eficiencias muy
# distintas, y falta la combinación 95-14-40-Pelton-1 boquilla.
# Posiblemente hay un error de digitación en la Tabla 6 del artículo.
# -----------------------------------------------------------------
# 4. Variable respuesta: eficiencia
# -----------------------------------------------------------------
y <- datos$eficiencia
resumen_y <- c(
n          = length(y),
media      = mean(y),
mediana    = median(y),
de         = sd(y),
cv_pct     = 100 * sd(y) / mean(y),
minimo     = min(y),
maximo     = max(y),
rango_iq   = IQR(y),
asimetria  = mean((y - mean(y))^3) / sd(y)^3,
curtosis   = mean((y - mean(y))^4) / sd(y)^4 - 3  # exceso de curtosis
)
round(resumen_y, 4)
# Cuartiles y límites de los bigotes del diagrama de caja.
# Un valor se considera atípico si está a más de 1.5 * RIQ de la caja.
cuartiles <- quantile(y, probs = c(0.25, 0.75))   # Q1 y Q3
cuartiles
lim_inf <- cuartiles[[1]] - 1.5 * IQR(y)
lim_sup <- cuartiles[[2]] + 1.5 * IQR(y)
round(c(lim_inf = lim_inf, lim_sup = lim_sup), 4)
sum(y < lim_inf | y > lim_sup)   # número de corridas atípicas
# Histograma con curva de densidad
g1 <- ggplot(datos, aes(x = eficiencia)) +
geom_histogram(aes(y = after_stat(density)), bins = 12,
fill = "steelblue", color = "white") +
geom_density(linewidth = 0.8) +
geom_vline(xintercept = mean(y), linetype = "dashed", color = "red") +
labs(title = "Distribución de la eficiencia hidráulica",
subtitle = "Línea roja: media",
x = "Eficiencia hidráulica", y = "Densidad")
print(g1)
# Boxplot con los puntos observados
g2 <- ggplot(datos, aes(x = "", y = eficiencia)) +
geom_boxplot(fill = "steelblue", alpha = 0.4, outlier.shape = NA) +
geom_jitter(width = 0.1, alpha = 0.6) +
labs(title = "Boxplot de la eficiencia hidráulica",
x = NULL, y = "Eficiencia hidráulica")
print(g2)
# -----------------------------------------------------------------
# 5. Eficiencia según cada variable explicativa
# -----------------------------------------------------------------
# Función para resumir la eficiencia en cada nivel de una variable
resumen_por <- function(variable) {
res <- aggregate(datos$eficiencia, by = list(nivel = datos[[variable]]),
FUN = function(x) c(n = length(x), media = mean(x),
de = sd(x), min = min(x), max = max(x)))
res <- data.frame(variable = variable, nivel = res$nivel, round(res$x, 4))
res
}
tabla_niveles <- do.call(rbind, lapply(
c("angulo", "diametro", "distancia", "rodete", "boquillas"), resumen_por))
tabla_niveles
# Base en formato "largo" para graficar todas las variables juntas
largo <- do.call(rbind, lapply(
c("angulo", "diametro", "distancia", "rodete", "boquillas"),
function(v) data.frame(variable = v,
nivel = as.character(datos[[v]]),
eficiencia = datos$eficiencia)))
largo$variable <- factor(largo$variable,
levels = c("angulo", "diametro", "distancia", "rodete", "boquillas"),
labels = c("Ángulo (grados)", "Diámetro (mm)", "Distancia (mm)",
"Tipo de rodete", "Número de boquillas"))
g3 <- ggplot(largo, aes(x = nivel, y = eficiencia)) +
geom_boxplot(fill = "grey85", outlier.shape = NA) +
geom_jitter(width = 0.15, alpha = 0.5, color = "steelblue") +
stat_summary(fun = mean, geom = "point", shape = 18, size = 3, color = "red") +
facet_wrap(~ variable, scales = "free_x") +
labs(title = "Eficiencia hidráulica según cada variable explicativa",
subtitle = "Rombo rojo: media del grupo",
x = NULL, y = "Eficiencia hidráulica")
print(g3)
# -----------------------------------------------------------------
# 6. Gráficos de medias con intervalos de confianza del 95 %
# -----------------------------------------------------------------
# Muestran cómo cambia la eficiencia media al pasar de un nivel a otro.
# Intervalo t para la media: media +/- t(0.975, n-1) * s / sqrt(n)
ic95 <- function(x) {
m <- mean(x)
e <- qt(0.975, df = length(x) - 1) * sd(x) / sqrt(length(x))
data.frame(y = m, ymin = m - e, ymax = m + e)
}
g4 <- ggplot(largo, aes(x = nivel, y = eficiencia, group = 1)) +
stat_summary(fun = mean, geom = "line", color = "steelblue") +
stat_summary(fun = mean, geom = "point", size = 2.5, color = "steelblue") +
stat_summary(fun.data = ic95, geom = "errorbar", width = 0.15) +
facet_wrap(~ variable, scales = "free_x") +
labs(title = "Eficiencia media e intervalo de confianza del 95 %",
x = NULL, y = "Eficiencia hidráulica media")
print(g4)
# Los mismos intervalos en una tabla, para citarlos en el artículo.
# aggregate() aplica ic95() a la eficiencia de cada nivel de cada variable
tabla_ic <- aggregate(eficiencia ~ variable + nivel, data = largo,
FUN = function(x) unlist(ic95(x)))
tabla_ic <- data.frame(tabla_ic[, c("variable", "nivel")],
round(tabla_ic$eficiencia, 4))
names(tabla_ic)[3:5] <- c("media", "lim_inf", "lim_sup")
tabla_ic <- tabla_ic[order(tabla_ic$variable), ]          # ordenar por variable
tabla_ic$ancho <- tabla_ic$lim_sup - tabla_ic$lim_inf   # ancho del intervalo
tabla_ic
# -----------------------------------------------------------------
# 7. Gráficos de perfiles (posibles interacciones)
# -----------------------------------------------------------------
# Si las líneas no son paralelas, el efecto de una variable depende
# del tipo de rodete y del número de boquillas (interacción)
datos$grupo <- interaction(datos$rodete, datos$boquillas, sep = " - ")
perfil <- function(variable, etiqueta) {
ggplot(datos, aes(x = .data[[variable]], y = eficiencia,
color = grupo, group = grupo)) +
stat_summary(fun = mean, geom = "line", linewidth = 0.9) +
stat_summary(fun = mean, geom = "point", size = 2.5) +
scale_x_continuous(breaks = sort(unique(datos[[variable]]))) +
scale_color_brewer(palette = "Dark2") +
labs(title = paste("Perfil de la eficiencia media según", tolower(etiqueta)),
x = etiqueta, y = "Eficiencia hidráulica media",
color = "Rodete - boquillas")
}
p_angulo    <- perfil("angulo",    "Ángulo de la boquilla (grados)")
p_diametro  <- perfil("diametro",  "Diámetro de la boquilla (mm)")
p_distancia <- perfil("distancia", "Distancia boquilla-rodete (mm)")
print(p_angulo)
print(p_diametro)
print(p_distancia)
# Medias de cada combinación rodete - boquillas en cada nivel
# (son los puntos de los gráficos de perfiles)
tapply(datos$eficiencia, list(datos$grupo, datos$angulo), mean)
tapply(datos$eficiencia, list(datos$grupo, datos$diametro), mean)
tapply(datos$eficiencia, list(datos$grupo, datos$distancia), mean)
# -----------------------------------------------------------------
# 8. Gráfico condicional
# -----------------------------------------------------------------
# Eficiencia vs. ángulo, separando por rodete y número de boquillas,
# y coloreando por diámetro
g5 <- ggplot(datos, aes(x = angulo, y = eficiencia, color = factor(diametro))) +
geom_jitter(width = 0.3, height = 0, size = 2, alpha = 0.8) +
facet_grid(boquillas ~ rodete) +
scale_x_continuous(breaks = c(90, 92.5, 95)) +
scale_color_brewer(palette = "Set1") +
labs(title = "Eficiencia vs. ángulo, por rodete y número de boquillas",
x = "Ángulo de la boquilla (grados)", y = "Eficiencia hidráulica",
color = "Diámetro (mm)")
print(g5)
# Eficiencia media para cada combinación de ángulo (filas) y diámetro
# (columnas): sirve para ver si el efecto del diámetro cambia con el ángulo
round(tapply(datos$eficiencia, list(datos$angulo, datos$diametro), mean), 4)
# -----------------------------------------------------------------
# 9. Resumen multivariado de las variables numéricas
# -----------------------------------------------------------------
numericas <- datos[, c("angulo", "diametro", "distancia", "eficiencia")]
colMeans(numericas)                 # vector de medias
round(var(numericas), 5)            # matriz de varianzas y covarianzas
round(cor(numericas), 3)            # correlaciones de Pearson
round(cor(numericas, method = "spearman"), 3)  # correlaciones de Spearman
# Las explicativas casi no están correlacionadas entre sí: es lo que se
# espera de un diseño experimental, donde los niveles se fijan de forma
# planificada.
# Correlaciones dentro de cada tipo de rodete (las que muestra ggpairs
# en la parte de arriba de la matriz, junto a la correlación total)
by(numericas, datos$rodete, function(d) round(cor(d), 3))
# Matriz de dispersión, coloreando por tipo de rodete (verde = Pelton,
# naranja = Turgo).
# A ggpairs() no se le suman capas con "+" (escalas, títulos) porque eso
# falla con algunas combinaciones de versiones de GGally y ggplot2. Los
# colores se fijan con las opciones globales de ggplot2 y luego se
# devuelven a como estaban.
colores_rodete <- c("#1B9E77", "#D95F02")
opciones_previas <- options(ggplot2.discrete.colour = colores_rodete,
ggplot2.discrete.fill   = colores_rodete)
g6 <- ggpairs(datos[, c("angulo", "diametro", "distancia", "eficiencia", "rodete")],
mapping = aes(color = rodete, alpha = 0.5),
columnLabels = c("Ángulo", "Diámetro", "Distancia",
"Eficiencia", "Rodete"),
title = "Matriz de dispersión por tipo de rodete")
# Si aun así no se puede dibujar, se usa la matriz de dispersión de R base
dibujo_ok <- tryCatch({
suppressMessages(print(g6))
TRUE
}, error = function(e) FALSE)
if (!dibujo_ok) {
message("ggpairs() no se pudo dibujar con estas versiones de paquetes; ",
"se usa pairs() de R base")
pairs(numericas,
col = ifelse(datos$rodete == "Pelton", colores_rodete[1], colores_rodete[2]),
pch = 19,
labels = c("Ángulo", "Diámetro", "Distancia", "Eficiencia"),
main = "Matriz de dispersión (verde = Pelton, naranja = Turgo)")
}
options(opciones_previas)
